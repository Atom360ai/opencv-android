<?xml version="1.0" encoding="utf-8"?>
<!--
    android:extractNativeLibs="false" is merged into every consuming app's
    manifest via the manifest merger.  It tells the OS to memory-map .so files
    directly from the APK (at their stored offset) rather than extracting them
    to disk first.  Combined with jniLibs.useLegacyPackaging = false in
    build.gradle, the .so files are stored uncompressed and 16 KB-aligned inside
    the APK — satisfying the Android 15 (API 35) 16 KB page-size requirement.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:extractNativeLibs="false" />

</manifest>
